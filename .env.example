# URL canônica do ambiente (sem barra final).
# Só https://cidados.insper.edu.br é indexado pelos buscadores.
# Produção (Docker/Insper): https://cidados.insper.edu.br
# Preview/Vercel: https://portal-cidados.vercel.app  (noindex automático)
# Local: http://localhost:3000  (noindex automático)
NEXT_PUBLIC_SITE_URL=https://cidados.insper.edu.br

# Mapbox (obrigatório para geoportal e histórias com mapa)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics (opcional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_CLARITY_ID=

# Verificação de propriedade em ferramentas de webmaster (opcional)
# Google Search Console — meta tag "google-site-verification"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Alias aceito pelo código (mesmo valor)
# NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools — meta tag "msvalidate.01"
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Estilo custom do Mapbox para a história adensamento (opcional)
# NEXT_PUBLIC_MAPBOX_STYLE_ADENSAMENTO=

# História de transporte e habitação. Só a string true publica a rota,
# a home e o índice. Ausente ou qualquer outro valor mantém oculta.
# O valor entra no build: reinicie o dev server ou gere a imagem de novo.
# NEXT_PUBLIC_FEATURE_HABITACAO=true
